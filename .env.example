# Every value below is optional except ANTHROPIC_API_KEY.

# Chat model, through the Anthropic API (key in ANTHROPIC_API_KEY)
CHAT_MODEL=claude-haiku-5-5
# Thinking effort: low | medium | high | xhigh | max (higher = better reasoning, slower, more tokens)
ANTHROPIC_EFFORT=medium
# API calls stop once the estimated spend reaches this many USD (tracked in .cache/anthropic-spend.json).
# Also set a spend limit in the Claude Console: that one is the hard cap.
ANTHROPIC_BUDGET_USD=5

# Embedding model, run in-process on CPU (downloaded once to .cache/models)
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5

# Retrieval
# Chunks sent to the chat model; fewer = shorter prompt = fewer tokens billed
RETRIEVAL_K=5
# Cross-encoder that re-orders the top RERANK_CANDIDATES hybrid hits before keeping RETRIEVAL_K
# (runs in Node, downloaded once to .cache/models; empty = no re-ranking)
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20
VECTOR_WEIGHT=0.6
KEYWORD_WEIGHT=0.4

# Server
PORT=3000
DOCS_DIR=docs
LLM_TIMEOUT_MS=60000
# Used for "today" when a request does not send one
STORE_TIMEZONE=America/New_York

# Eval runner: parallel conversations
EVAL_CONCURRENCY=1

ANTHROPIC_API_KEY=
